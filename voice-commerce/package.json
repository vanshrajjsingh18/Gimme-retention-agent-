{
  "name": "gimme-voice-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "GIMME Voice Commerce: MCP server, Voice API and platform adapters for voice ordering",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "docs:generate": "tsx scripts/generate-specs.ts",
    "demo": "tsx scripts/demo-voice-flow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
