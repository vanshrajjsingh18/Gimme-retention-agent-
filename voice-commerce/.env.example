# GIMME Voice Commerce — every value has a working sandbox default.
# See docs/deployment.md for the production list.

VOICE_ENV=sandbox
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# OAuth (resource server). Production: set OAUTH_JWKS_URL; the sandbox secret is ignored.
OAUTH_ISSUER=https://auth.sandbox.gimme.local
# OAUTH_AUDIENCE=http://localhost:8787
# OAUTH_JWKS_URL=https://auth.gimme.example/.well-known/jwks.json
# SANDBOX_TOKEN_SECRET=

# Server-only secrets. Production: required, 32+ random characters, from a secrets manager.
# PURCHASE_AUTHORIZATION_KEY=
# INTERNAL_EVENTS_SECRET=

# WEBHOOK_SUBSCRIBERS=[{"url":"https://adapter.example/hooks/gimme","secret":"change-me","events":["order.*","payment.*"]}]

# REQUIRE_DEVICE_AUTH_PLATFORMS=APPLE,GOOGLE
# ALLOW_MCP_FORM_CONFIRMATION=true
# LOG_LEVEL=info
