# =============================================================================
# GIMME Retention Engine — environment configuration
#
# Copy to .env and adjust. Every value below has a working default, so the app
# runs with an empty .env; nothing here is required to start.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="GIMME Retention Engine"
ENVIRONMENT=local
DEBUG=true

# --- Security ----------------------------------------------------------------
# CHANGE THIS before running anywhere other than your own machine. It signs the
# session tokens and derives the API-key hashes; rotating it invalidates both.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Local development login. Change the password before any shared deployment.
ADMIN_EMAIL=admin@gimmedelivery.co.nz
ADMIN_PASSWORD=GimmeAdmin123!

# --- Database ----------------------------------------------------------------
# SQLite by default. The schema avoids SQLite-only constructs, so moving to
# PostgreSQL is only a URL change:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gimme
DATABASE_URL=sqlite:////app/data/gimme.db

# --- CORS --------------------------------------------------------------------
# Explicit origins rather than "*", because requests carry credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Language model ----------------------------------------------------------
# "mock" generates messages locally with no external call — the default, and
# fully functional. Set "openai" with a key for a real provider; any
# OpenAI-compatible endpoint works (OpenAI, Azure gateway, vLLM, Ollama,
# OpenRouter). If LLM_API_KEY is empty the system falls back to mock rather
# than failing a send.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# --- Messaging providers -----------------------------------------------------
# "mock" records messages locally with realistic simulated delivery and
# engagement; nothing leaves the machine. Switch an individual provider to
# "live" on the Integrations screen once its credentials are stored — a
# half-configured provider falls back to mock instead of dropping messages.
EMAIL_PROVIDER_MODE=mock
SMS_PROVIDER_MODE=mock
WHATSAPP_PROVIDER_MODE=mock

# --- Background jobs ---------------------------------------------------------
# Refreshes intelligence, dispatches scheduled campaigns and ingests the local
# inbox folder. Disable when running tests or a one-off script.
ENABLE_SCHEDULER=true
SCHEDULER_METRICS_INTERVAL_MINUTES=60

# --- Demo data ---------------------------------------------------------------
# Fixed seed so the generated dataset and every simulated event are
# reproducible across runs and machines.
MOCK_SEED=20240101

# --- Ingestion ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
INBOX_DIR=/app/data/inbox

# --- Frontend ----------------------------------------------------------------
# Where the browser reaches the API. Read at build time by Vite.
VITE_API_URL=http://127.0.0.1:8000
