# =============================================================================
# GIMME Retention Engine — environment configuration
#
# Copy to .env and adjust. Every value below has a working default, so the app
# runs with an empty .env; nothing here is required to start.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="GIMME Retention Engine"
ENVIRONMENT=local
DEBUG=true

# --- Security ----------------------------------------------------------------
# CHANGE THIS before running anywhere other than your own machine. It signs the
# session tokens and derives the API-key hashes; rotating it invalidates both.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Local development login. Change the password before any shared deployment.
ADMIN_EMAIL=admin@gimmedelivery.co.nz
ADMIN_PASSWORD=GimmeAdmin123!

# --- Database ----------------------------------------------------------------
# Left unset on purpose: the app then defaults to <repo>/data/gimme.db, which
# is correct whichever directory you run from. Docker Compose overrides this
# with the container path, so do not hard-code an absolute path here.
#
# The schema avoids SQLite-only constructs, so moving to PostgreSQL is only a
# URL change:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gimme
# DATABASE_URL=sqlite:///absolute/path/to/gimme.db

# --- CORS --------------------------------------------------------------------
# Explicit origins rather than "*", because requests carry credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Language model ----------------------------------------------------------
# "mock" generates messages locally with no external call — the default, and
# fully functional. Set "openai" with a key for a real provider; any
# OpenAI-compatible endpoint works (OpenAI, Azure gateway, vLLM, Ollama,
# OpenRouter). If LLM_API_KEY is empty the system falls back to mock rather
# than failing a send.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# --- Messaging providers -----------------------------------------------------
# "mock" records messages locally with realistic simulated delivery and
# engagement; nothing leaves the machine. Switch an individual provider to
# "live" on the Integrations screen once its credentials are stored — a
# half-configured provider falls back to mock instead of dropping messages.
EMAIL_PROVIDER_MODE=mock
SMS_PROVIDER_MODE=mock
WHATSAPP_PROVIDER_MODE=mock

# --- Background jobs ---------------------------------------------------------
# Refreshes intelligence, dispatches scheduled campaigns, runs due automations
# and ingests the local inbox folder. Disable when running tests or a one-off
# script.
ENABLE_SCHEDULER=true
SCHEDULER_METRICS_INTERVAL_MINUTES=60
# How often due automations are checked. Per-customer timing is stored on the
# rows themselves, so this only sets the resolution of the poll — five minutes
# is ample for a 9am-7pm send window, and it needs no queue broker.
AUTOMATION_TICK_MINUTES=5

# --- Sending hours -----------------------------------------------------------
# Every automated send is judged against the customer's local clock, not the
# server's. New Zealand is UTC+12 (NZST) or UTC+13 (NZDT), so a quiet-hours
# check against UTC would be wrong by half a day.
#
# A send falling outside the window is deferred to the next open slot rather
# than dropped — a job that runs at 3am still reaches customers at 9am.
# Behavioural nudges are the exception: a late-evening pattern is pulled back
# to the same local day, since reminding somebody after they would have
# ordered defeats the point.
BUSINESS_TIMEZONE=Pacific/Auckland
SEND_WINDOW_START=09:00
SEND_WINDOW_END=19:00

# --- Demo data ---------------------------------------------------------------
# Fixed seed so the generated dataset and every simulated event are
# reproducible across runs and machines.
MOCK_SEED=20240101

# --- Ingestion ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
# Also left unset: defaults to <repo>/data/inbox. Drop a CSV named
# customers-*.csv, orders-*.csv or order_items-*.csv in there and the
# scheduler imports it, moving it to processed/ or failed/ afterwards.
# INBOX_DIR=/absolute/path/to/inbox

# --- Frontend ----------------------------------------------------------------
# Where the browser reaches the API. Read at build time by Vite.
VITE_API_URL=http://127.0.0.1:8000
